<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header & Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mistakes Journal"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/dark_on_surface" />

            <TextView
                android:id="@+id/tv_mistakes_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track failure patterns &amp; build avoidance checklists"
                android:textSize="12sp"
                android:textColor="@color/dark_on_surface_variant"
                android:layout_marginTop="2dp" />

            <!-- Summary KPI Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:strokeColor="@color/dark_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Logged"
                            android:textSize="11sp"
                            android:textColor="@color/dark_on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_total_mistakes_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:text="0" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/dark_outline"
                        android:layout_marginHorizontal="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dominant Error Pattern"
                            android:textSize="11sp"
                            android:textColor="@color/dark_on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_dominant_mistake_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/medium_orange"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="None" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar -->
            <EditText
                android:id="@+id/et_search_mistakes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_indigo"
                android:hint="Search by problem title, notes..."
                android:textColorHint="@color/dark_on_surface_variant"
                android:textColor="@color/dark_on_surface"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <!-- Topic Filter Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Topic Filter:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_on_surface_variant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_topic"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="All Topics"
                    android:textSize="11sp"
                    android:textColor="@color/secondary"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Horizontal Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="All Mistakes"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_logical"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logical error"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_algorithm"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incorrect algorithm"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_edge_case"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edge case missed"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_tle"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Limit Exceeded"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_space"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Space complexity"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_syntax"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Syntax error"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_off_by_one"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off-by-one error"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_recursion"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recursion error"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_other"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other"
                    android:textColor="@color/dark_on_surface"
                    app:chipBackgroundColor="@color/dark_surface"
                    app:chipStrokeColor="@color/dark_outline"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Main Content Area: RecyclerView or Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_mistakes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="80dp"
                tools:listitem="@layout/item_mistake_card" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_mistakes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_nav_mistakes"
                    app:tint="@color/dark_on_surface_variant"
                    android:contentDescription="No mistakes" />

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No Mistakes Recorded"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_on_surface" />

                <TextView
                    android:id="@+id/tv_empty_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Logging failure reasons (Edge case, TLE, Logic error) helps you identify blind spots and avoid repeating them. Tap '+' to record your first mistake."
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_record_mistake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Record a Mistake"
                    android:textColor="@color/on_primary"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- FAB Record Mistake -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_record_mistake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/primary"
        app:tint="@color/on_primary"
        android:contentDescription="Record Mistake" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>


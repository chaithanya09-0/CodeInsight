<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_surface"
        app:title="Mistake Logger"
        app:titleTextColor="@color/dark_on_surface"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/dark_on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Problem Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/dark_surface_high"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_mistake_problem_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Problem Title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_on_surface" />

                    <TextView
                        android:id="@+id/tv_mistake_problem_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LeetCode • Medium • 2 attempts"
                        android:textColor="@color/dark_on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- New Mistake Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/dark_surface_high"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Record New Mistake"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Attempt Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Associate with Attempt"
                        android:textColor="@color/dark_on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp" />

                    <Spinner
                        android:id="@+id/spinner_attempts"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_badge_teal" />

                    <!-- Categories Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mistake Categories * (Select all that apply)"
                        android:textColor="@color/dark_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />

                    <!-- 9 Mistake Categories Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_mistake_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_logical_error"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logical error" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_syntax_error"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Syntax error" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_edge_case"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edge case missed" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_tle"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time Limit Exceeded" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_space_complexity"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Space complexity issue" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_incorrect_algo"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Incorrect algorithm" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_off_by_one"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Off-by-one error" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_recursion_error"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recursion error" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_other"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Other" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- What Went Wrong Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="What went wrong? (Optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_mistake_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dark_on_surface"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Root Cause / Prevention Note -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Root Cause &amp; Prevention Rule (Optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_mistake_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dark_on_surface"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Save Mistake Button -->
                    <Button
                        android:id="@+id/btn_save_mistake"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="Save Mistake"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Previously Logged Mistakes Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logged Mistakes"
                android:textColor="@color/dark_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_logged_mistakes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_no_mistakes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mistakes recorded for this problem yet."
                android:textColor="@color/dark_on_surface_variant"
                android:textSize="13sp"
                android:padding="20dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Extra padding for scroll -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/dark_surface_high"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_attempt_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accepted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/easy_green"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_attempt_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Java"
                android:textSize="11sp"
                android:textColor="@color/dark_on_surface_variant"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_attempt_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 15m"
                android:textSize="11sp"
                android:textColor="@color/dark_on_surface_variant"
                android:layout_marginStart="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_attempt_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov 7, 2026"
                android:textSize="11sp"
                android:textColor="@color/dark_on_surface_variant" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_attempt_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attempt observations"
            android:textColor="@color/dark_on_surface"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_attempt_mistakes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mistakes: Time Limit Exceeded"
            android:textColor="@color/hard_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


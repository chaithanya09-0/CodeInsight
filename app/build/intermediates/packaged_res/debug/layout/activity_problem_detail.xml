<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_surface"
        app:title="Problem Details"
        app:titleTextColor="@color/dark_on_surface"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/dark_on_surface"
        app:menu="@menu/menu_problem_detail" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/dark_surface_high"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_detail_platform"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LeetCode"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/leetcode_orange"
                            android:background="@drawable/bg_badge_orange"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/tv_detail_difficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/medium_orange"
                            android:background="@drawable/bg_badge_orange"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginStart="8dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_detail_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solved"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/easy_green" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Problem Title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_on_surface"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tv_detail_attempts_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total attempts: 0"
                        android:textColor="@color/dark_on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tv_detail_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open problem in browser"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <!-- Topics Group -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_detail_topics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notes Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/dark_surface_high"
                app:strokeWidth="0dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strategy &amp; Notes"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_detail_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_on_surface"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btn_log_attempt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Log Attempt"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/on_primary"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_log_mistake"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Log Mistake"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Attempts History Header -->
            <TextView
                android:id="@+id/tv_attempts_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attempt History"
                android:textColor="@color/dark_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_attempts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tv_attempts_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No attempts recorded yet. Tap 'Log Attempt' to track your practice trials."
                android:textColor="@color/dark_on_surface_variant"
                android:textSize="13sp"
                android:padding="20dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Extra padding for scroll -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>


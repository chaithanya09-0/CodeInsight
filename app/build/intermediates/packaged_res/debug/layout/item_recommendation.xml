<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/dark_surface_high"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Topic + Priority + Dismiss -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_rec_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recursion"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_badge_teal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_rec_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Priority"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/hard_red"
                android:background="@drawable/bg_badge_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_dismiss_rec"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/dark_on_surface_variant"
                android:contentDescription="Dismiss" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_rec_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Strengthen Base Cases &amp; State"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dark_on_surface"
            android:layout_marginTop="10dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_rec_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommendation description"
            android:textColor="@color/dark_on_surface_variant"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <!-- Data Reasoning Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/dark_surface"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data Behind This:"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rec_reasoning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Based on 5 attempts with 3 failures"
                android:textColor="@color/dark_on_surface"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Actionable Steps Checklist -->
        <TextView
            android:id="@+id/tv_rec_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Solve 3-5 Easy problems tagged with Recursion\n• Write out base cases first"
            android:textColor="@color/dark_on_surface_variant"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

